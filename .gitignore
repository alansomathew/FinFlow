# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Firebase app config (google-services.json / GoogleService-Info.plist /
# firebase_options.dart) is intentionally NOT excluded here — per Firebase's
# own guidance these contain no secrets (they're safe to ship inside the
# compiled app itself); the real security boundary is Firestore rules + App
# Check. CI needs them present to build. Only genuine secrets are excluded:
*.jks
*.keystore
key.properties
android/key.properties
.env
.env.*
functions/.env
functions/node_modules/
functions/lib/
serviceAccountKey*.json

# Local tooling state
.claude/
.qodo/
# Vendored copy of agent-skills docs fetched by `npx skills add` -- a local
# cache of skills-lock.json's declared skills, not project source.
.agents/

# Desktop/web platforms dropped from this project (Android-only) — Flutter
# tooling occasionally regenerates ephemeral scaffolding for them on
# `pub get`; never track it if it reappears.
/macos/
/windows/
/linux/
/web/
